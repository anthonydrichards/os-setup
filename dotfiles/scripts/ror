#!/usr/bin/env bash
# =============================================================================
# ror – Run-or-Raise
# Usage: ror <window-class> <launch-cmd> [extra args...]
#
# If a window matching <window-class> exists, focus it.
# Otherwise launch <launch-cmd>.
#
# Examples:
#   ror kitty  kitty
#   ror code   code
#   ror chromium chromium
# =============================================================================
set -euo pipefail

CLASS="${1:?Usage: ror <class> <cmd> [args...]}"
CMD="${2:?Usage: ror <class> <cmd> [args...]}"
shift 2

# Locate a window whose class contains the requested class.
ADDR=$(hyprctl clients -j | \
    python3 -c "
import sys, json
clients = json.load(sys.stdin)
cls = '${CLASS}'.lower()
for c in clients:
    if cls in c.get('class','').lower():
        print(c['address'], c['workspace']['id'])
        break
")

if [[ -n "${ADDR}" ]]; then
    WS="${ADDR##* }"
    WIN="${ADDR%% *}"
    # Hyprland 0.56's Lua API requires hl.dsp.focus(...).  The old
    # 'hyprctl dispatch focuswindow address:...' shorthand is broken
    # (it fails to quote the dispatcher argument).  The first focus
    # switches workspace, the second focuses the exact window.
    hyprctl repl "pcall(function() hl.dsp.focus({ workspace = ${WS} }); hl.dsp.focus({ window = 'address:${WIN}' }) end)"
else
    # Launch the application
    exec "${CMD}" "$@"
fi
